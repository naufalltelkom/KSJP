# syntax=docker/dockerfile:1
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json* vite.config.js ./
COPY resources ./resources
RUN npm install --no-audit --no-fund && npm run build

FROM php:8.3-apache

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    curl \
    libpq-dev \
    libicu-dev \
    libzip-dev \
    libsqlite3-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql pgsql pdo_sqlite intl zip bcmath exif \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

COPY . .
COPY --from=assets /app/public/build ./public/build

RUN composer dump-autoload --optimize --no-interaction \
    && php artisan package:discover --ansi \
    && php artisan filament:upgrade

# Apache DocumentRoot -> public/
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf \
    && sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf \
    && sed -ri -e 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf

# Pre-build seeded SQLite snapshot for stateless cold starts when no external Postgres URL is configured
RUN mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache/data storage/logs bootstrap/cache \
    && touch database/ksjp-seed.sqlite \
    && APP_KEY="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" \
       DB_CONNECTION=sqlite \
       DB_DATABASE=/var/www/html/database/ksjp-seed.sqlite \
       php artisan migrate --force \
    && APP_KEY="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" \
       DB_CONNECTION=sqlite \
       DB_DATABASE=/var/www/html/database/ksjp-seed.sqlite \
       php artisan db:seed --force \
    && chmod 664 database/ksjp-seed.sqlite \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache /var/www/html/database

COPY docker/vercel-entrypoint.sh /usr/local/bin/vercel-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/vercel-entrypoint.sh && chmod +x /usr/local/bin/vercel-entrypoint.sh

EXPOSE 80
ENTRYPOINT ["/usr/local/bin/vercel-entrypoint.sh"]
